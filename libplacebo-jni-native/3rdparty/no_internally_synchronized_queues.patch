+++ b/src/vulkan/context.c
@@ -20,6 +20,13 @@
 #include "utils.h"
 #include "gpu.h"
 
+// Gamescope's WSI layer builds its queue table by calling vkGetDeviceQueue for every queue an
+// application asked for, which is only defined for a queue created without flags and hands back
+// nothing for one that carries any. Enabling this extension makes libplacebo flag its queues, so
+// that layer ends up asserting on a null queue and aborts the process. Nothing is lost by going
+// without it beyond libplacebo keeping its own queue mutex instead of skipping the locking.
+#undef VK_KHR_internally_synchronized_queues
+
